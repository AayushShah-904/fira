NODE_ENV=production
PORT=4000

# IMPORTANT: Generate a strong random secret for production
# Run: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHAR_STRING
JWT_EXPIRES=24h

CORS_ORIGIN=https://fia.bharatomni.com
DB_PATH=/opt/fira/data/fira.db

# SMTP — configure for real email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@fira.in
UPGRADE_NOTIFY_EMAIL=business@bharatomni.com
