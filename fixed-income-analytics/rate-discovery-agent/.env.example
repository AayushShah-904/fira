# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Responses API (web search) requires a newer version
AZURE_OPENAI_RESPONSES_API_VERSION=2025-03-01-preview

# Two-tier model deployments
# Tier 1 (mini): cheap/fast, used for ~70% of banks (static HTML, known domains)
# Tier 2 (full): capable, used for complex pages (JS-rendered, WAF, NRI discovery)
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4.1-mini
AZURE_OPENAI_DEPLOYMENT_FULL=gpt-4.1

# Legacy single-model override (used if tier vars not set, e.g. by agent.js directly)
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# Web search: Three strategies (tried in order)
# 1. Bing Search API (if BING_SEARCH_API_KEY is set)
# 2. Azure OpenAI Responses API built-in web_search (uses AZURE_OPENAI_ENDPOINT, no extra resource)
# 3. Graceful fallback (guides agent to try bank.in URLs directly)
#
# For most users: leave BING_SEARCH_API_KEY empty — Responses API web_search works with
# just the Azure OpenAI endpoint. Cost: ~$2 per 1K search grounding transactions.
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# Agent settings
AGENT_MAX_TOOL_CALLS=15
LOG_LEVEL=warn

# Cost tracking (Azure OpenAI pricing per 1M tokens)
# Tier 2 (full) — GPT-4.1
AZURE_OPENAI_FULL_INPUT_PRICE_PER_1M=2.00
AZURE_OPENAI_FULL_OUTPUT_PRICE_PER_1M=8.00
# Tier 1 (mini) — GPT-4.1-mini
AZURE_OPENAI_MINI_INPUT_PRICE_PER_1M=0.40
AZURE_OPENAI_MINI_OUTPUT_PRICE_PER_1M=1.60
