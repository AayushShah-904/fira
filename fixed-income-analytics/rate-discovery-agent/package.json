{
  "name": "rate-discovery-agent",
  "version": "1.0.0",
  "description": "A Claude Code agent that discovers bank interest rate pages and extracts rate data for the Indian Bank Interest Rate Aggregator project.",
  "main": "index.js",
  "scripts": {
    "test": "node --test --test-force-exit",
    "test:golden": "node --test tests/extractors/golden.test.js",
    "pretest": "node scripts/check-write-discipline.js",
    "check:writes": "node scripts/check-write-discipline.js",
    "build-pack": "node pack/build-pack.js",
    "sync:fira": "node sync-rates-to-fira.js",
    "sync:fira:dry": "node sync-rates-to-fira.js --dry-run",
    "quality-gate": "node scripts/quality-gate.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@azure/ai-form-recognizer": "^5.1.0",
    "@traceai/fi-core": "^1.0.0",
    "@traceai/openai": "^0.1.13",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "openai": "^4.104.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.0.379",
    "playwright": "^1.58.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "unstorage": "^1.16.0"
  }
}
