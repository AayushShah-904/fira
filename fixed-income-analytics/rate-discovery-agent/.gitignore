# Discovery outputs — track config + rate data + summaries, exclude logs/traces
output/latest/*.log
output/latest/*.trace.jsonl
output/runs/
output/archive/
output/domain-discovery/
output/*.csv
output/*.log
output/*.pdf
output/*.tar.gz

# Source-snapshot substrate (Sprint 008 Phase 1): local-regenerable via
# scripts/snapshot/backfill-snapshots.js (like output/runs/). The committed
# golden .html companions in tests/golden-html/ are the durable artifacts;
# the snapshot store itself (blobs + ledger) is not tracked. (ADR-015 amended.)
output/snapshots/

# Per-run audit + cross-check outputs (Sprint 008 Phase 2/4) — regenerated.
output/audit/
output/snapshot-backfill.log
output/audit-run.log
# Golden snapshot pins (Sprint 008 Phase 6) — local retention state; the .html
# companions in tests/golden-html/ are the durable committed golden inputs.
output/snapshots/golden-pins.json
# Confidence sidecars (Sprint 008 Phase 5) — derived from build-confidence.js.
output/latest/_confidence/
# Macro-rate proposal (Sprint 008 Phase 7) — transient; the approved
# data/macro-rates.json is the committed artifact (ADR-017).
data/macro-rates.proposed.json

# Keep the directory
!output/.gitkeep

# Environment
.env

# Python
__pycache__/
*.pyc
# Dependencies
node_modules/
node_modules

# OS
.DS_Store
Thumbs.db

# Bicep compiled output (generated by `bicep build`)
iac/**/*.json

# Scratch / run artifacts (repo hygiene)
tmp/
*.zip
*.log
.tmp-*
*.tmp.*
*-tmp.html
/resume.txt
/rates-pack.*.json