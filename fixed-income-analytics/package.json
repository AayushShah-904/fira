{
  "name": "bird",
  "version": "0.1.0",
  "private": true,
  "description": "BIRD — Bank Interest Rate Dashboard",
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/scraper"
  ],
  "scripts": {
    "dev": "npm run dev -w @bird/api",
    "build": "npm run build -w @bird/shared && npm run build -w @bird/api",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "3.24.4"
  },
  "overrides": {
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.0.18"
  }
}
